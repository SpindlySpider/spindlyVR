&pinctrl {
  pwm0_default_custom: pwm0_default_custom {
    group1 {
      psels = <NRF_PSEL(PWM_OUT0,0,6)>;
      nordic,invert;
    };
  };
  pwm0_sleep_custom: pwm0_sleep_custom {
    group1 {
      psels = <NRF_PSEL(PWM_OUT0,0,6)>;
      low-power-enable;
    };
  };
};

&pwm0 {
  status = "okay";
  // set pin control 0 to output mode
  pinctrl-0 = <&pwm0_default_custom>;
  pinctrl-1 = <&pwm0_sleep_custom>;
  // change pin control to only be out and no low power mode
  pinctrl-names = "default","sleep";
};

/ {
  pwm_signals: pwm_signals{
    compatible = "pwm-leds";
    pwm_stepper: pwm_stepper {
        pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        label = "stepper";
    };
  };
};
