/ {
  // required for setting ADC
  zephyr,user {
    io-channels=<&adc 0>;
  };

  tx: tx{
    compatible = "pwm-leds";

    coil_1: coil_1 {
      // this pin is used to pulse tx
      pwms = <&pwm0 0 31250 PWM_POLARITY_NORMAL>;

    };

    // keep this pin low for transmission
    coil_2: coil_2 {
      pwms = <&pwm0 1 31250 PWM_POLARITY_INVERTED >;
    };
  };


};

// enable ADC and PWM

&adc {
  status = "okay";
  compatible = "nordic,nrf-saadc";
};

&timer3 {
    status = "okay";
};

&timer4 {
    status = "okay";
};

&hfxo{
    status = "okay";
};

&clock{
    status = "okay";
};

&i2c0{
  // https://koen.vervloesem.eu/blog/how-to-change-the-default-i2c-pins-in-zephyr/
  status = "okay";
  compatible = "nordic,nrf-twim";
  pinctrl-0 = <&i2c0_default>;
  clock-frequency = <I2C_BITRATE_STANDARD>;
  pinctrl-1 = <&i2c0_sleep>;
  pinctrl-names = "default","sleep";
  mpu6500: mpu6500@68 {
      compatible = "invensense,mpu6050";
      reg = <0x68>;
      status = "okay";
      gyro-fs = <2000>;
      accel-fs = <2>;
  };
  qmc_5883p: qmc_5883p@0 {
    // use this to set which i2c bus you are using for qmc_5883p
    reg = <0x0>;
  };
};


//TODO: add proper sleep definition for pincrtl-1
&pwm0 {
  status = "okay";
  // set pin control with 'pwm0_default'
  pinctrl-0 = <&pwm0_default>;
  pinctrl-1 = <&pwm0_default>;
  pinctrl-names = "default","sleep";
};


// set up pins for PWM
&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
          psels = <NRF_PSEL(PWM_OUT0,1,4)>,
            <NRF_PSEL(PWM_OUT1,1,6)>;
            };
    };

    i2c0_default: i2c0_default{
      group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
    };
      bias-pull-up;
  };

  i2c0_sleep: i2c0_sleep {
    group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;

        low-power-enable;
    };
  };
};
